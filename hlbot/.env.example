MODE=shadow                       # shadow = live books, hypothetical fills | live = real orders
# LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY
COINS=BTC,ETH,SOL,XRP
PORT=8788
# HOST=127.0.0.1

# ---- live only: create an API (agent) wallet at app.hyperliquid.xyz/API — it can trade, not withdraw ----
HL_AGENT_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=               # your main account address (the agent trades on its behalf)

# ---- fees (bps, base tier) ----
TAKER_FEE_BPS=4.5
MAKER_FEE_BPS=1.5
EXIT_FEE_BPS=4.5

# ---- signal (bps AFTER entry+exit fees) ----
TAKE_EDGE_BPS=3
MAKE_EDGE_BPS=1.5
EXIT_EDGE_BPS=0
HORIZON_SEC=10

# ---- sizing / risk ----
CLIP_USD=200
MAX_POS_USD=1000
MAX_GROSS_USD=3000
MAX_HOLD_SEC=90
STOP_BPS=25
DAILY_LOSS_LIMIT=300
LEVERAGE=3
MAKER_TTL_MS=4000
SHADOW_LATENCY_MS=120
