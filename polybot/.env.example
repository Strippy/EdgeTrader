# ---- mode ----
MODE=shadow                     # shadow = live data, hypothetical fills | live = real orders
# LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY

# ---- markets ----
ASSETS=btc,eth,sol,xrp
TIMEFRAMES=5m,15m
PORT=8787
# HOST=127.0.0.1                # dashboard bind address (keep local; tunnel if remote)

# ---- credentials ----
# Needed for the Chainlink reference stream (PolyBolt requires CLOB auth) even in shadow mode.
# For shadow, a fresh throwaway key with no funds is enough:
#   node -e "import('viem/accounts').then(a=>console.log(a.generatePrivateKey()))"
SIGNER_PRIVATE_KEY=
# Live only:
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
# POLYMARKET_BUILDER_CODE=

# ---- sizing / risk ----
CLIP_USD=25
MAX_CLIP_MULT=3
MAX_MARKET_USD=300
MAX_NET_SHARES=400
DAILY_LOSS_LIMIT=500
COOLDOWN_MS=1200

# ---- signal ($/share, after taker fee) ----
MIN_EDGE=0.025
HEDGE_EDGE=0.0
PAIR_TARGET=0.985
MAX_SLIP=0.02

# ---- timing ----
NO_NEW_RISK_LAST_SEC=15
NO_TRADE_LAST_SEC=3
SHADOW_LATENCY_MS=250
